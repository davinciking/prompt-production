# Copy this file to `content-marketing-workspace/.env` and fill in your ElevenLabs credentials.
# Never commit `.env` to git (already ignored in `.gitignore`).

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ACE_VOICE_ID=your_cloned_ace_voice_id_here

# Optional Speech-to-Speech model & tuning
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.15
